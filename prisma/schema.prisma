generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Roles de usuario. Los registros base (ADMIN, CLIENTE) los crea la migración.
model Rol {
  id       Int       @id @default(autoincrement())
  codigo   String    @unique @db.VarChar(30)
  nombre   String    @db.VarChar(60)
  usuarios Usuario[]
}

// Usuarios del sitio. Ingresan con nombre de usuario o DNI.
model Usuario {
  id           String   @id @default(cuid()) @db.VarChar(30)
  nombre       String   @db.VarChar(120)
  username     String   @unique @db.VarChar(40)
  dni          String?  @unique @db.VarChar(12)
  passwordHash String   @db.VarChar(255)
  activo       Boolean  @default(true)
  rolId        Int
  rol          Rol      @relation(fields: [rolId], references: [id], onDelete: Restrict)
  sesiones     Sesion[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([rolId])
}

// Sesiones de login. Solo se guarda el hash SHA-256 del token de la cookie.
model Sesion {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @db.Char(64)
  usuarioId String   @db.VarChar(30)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// Categorías del catálogo en árbol de hasta 3 niveles (0 = raíz, 1 = hija,
// 2 = nieta). parentId es la fuente de verdad; ruta ("/1/4/9/") y nivel se
// derivan y los mantiene la app al crear o mover una categoría.
model Categoria {
  id          Int         @id @default(autoincrement())
  nombre      String      @db.VarChar(80)
  slug        String      @unique @db.VarChar(100)
  descripcion String?     @db.VarChar(300)
  // Archivo WebP (medidas en src/features/categorias/imagen-size.ts), en BRISABEL_UPLOADS_DIR/categorias.
  imagen      String?     @db.VarChar(120)
  orden       Int         @default(0)
  activa      Boolean     @default(true)
  parentId    Int?
  parent      Categoria?  @relation("Jerarquia", fields: [parentId], references: [id], onDelete: Restrict)
  hijas       Categoria[] @relation("Jerarquia")
  productos   Producto[]
  ruta        String      @db.VarChar(255)
  nivel       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([parentId, orden])
  @@index([ruta])
}

// Productos del catálogo. Solo se asignan a categorías sin subcategorías
// (regla aplicada por la app). precioCosto es interno: nunca se muestra en la tienda.
model Producto {
  id          Int       @id @default(autoincrement())
  sku         String    @unique @db.VarChar(40)
  nombre      String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(170)
  precioCosto Decimal   @db.Decimal(12, 2)
  precioVenta Decimal   @db.Decimal(12, 2)
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  activo      Boolean   @default(true)
  destacado   Boolean   @default(false)
  // Archivo WebP cuadrado, en BRISABEL_UPLOADS_DIR/productos.
  imagen      String?   @db.VarChar(120)
  creado      DateTime  @default(now())
  modificado  DateTime  @updatedAt

  @@index([categoriaId, activo])
  @@index([activo, destacado])
}
