generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id           String          @id @default(cuid()) @db.VarChar(40)
  nombre       String          @db.VarChar(120)
  dni          String          @unique @db.VarChar(20)
  email        String?         @unique @db.VarChar(160)
  passwordHash String          @db.VarChar(255)
  rol          RolUsuario      @default(ADMIN)
  activo       Boolean         @default(true)
  sesiones     SesionUsuario[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model SesionUsuario {
  id        String   @id @default(cuid()) @db.VarChar(40)
  tokenHash String   @unique @db.VarChar(64)
  usuarioId String   @db.VarChar(40)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([expiresAt])
}

enum RolUsuario {
  ADMIN
  OPERADOR
}

model Categoria {
  id          String      @id @default(cuid()) @db.VarChar(40)
  nombre      String
  slug        String      @unique
  descripcion String?     @db.VarChar(500)
  orden       Int         @default(0)
  parentId    String?     @db.VarChar(40)
  parent      Categoria?  @relation("CategoriaJerarquia", fields: [parentId], references: [id], onDelete: SetNull)
  children    Categoria[] @relation("CategoriaJerarquia")
  productos   Producto[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([parentId])
  @@index([parentId, orden])
}

model Producto {
  id          String    @id @default(cuid())
  codigo      String    @unique
  descripcion String    @db.VarChar(500)
  precioCosto Decimal   @db.Decimal(12, 2)
  precioVenta Decimal   @db.Decimal(12, 2)
  imagen      String?   @db.VarChar(500)
  categoriaId String    @db.VarChar(40)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoriaId])
}
