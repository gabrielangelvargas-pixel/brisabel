# URL publica de la app (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MySQL de Hostinger. Desde tu PC usa el host remoto (Remote MySQL en hPanel);
# desde la app desplegada en Hostinger suele ser localhost.
DATABASE_URL="mysql://USUARIO:PASSWORD@HOST:3306/BASE?connection_limit=5"

# Carpeta persistente para imágenes subidas desde el panel (fuera del deploy).
# En Hostinger: /home/u605057087/domains/brisabel.com.ar/imagenes
# En local se puede omitir (usa ../BrisaBel-uploads).
BRISABEL_UPLOADS_DIR=""

# Notificaciones push (Web Push / VAPID). Generar un par con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Sin estas variables el sitio funciona igual, solo sin notificaciones.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto para los servicios de push: https://... o mailto:...
VAPID_SUBJECT="https://brisabel.com.ar"
