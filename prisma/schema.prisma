generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model Categoria {
  id          String      @id @default(cuid())
  nombre      String
  slug        String      @unique
  descripcion String?     @db.VarChar(500)
  orden       Int         @default(0)
  parentId    String?
  parent      Categoria?  @relation("CategoriaJerarquia", fields: [parentId], references: [id], onDelete: SetNull)
  children    Categoria[] @relation("CategoriaJerarquia")
  productos   Producto[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([parentId])
  @@index([parentId, orden])
}

model Producto {
  id          String    @id @default(cuid())
  codigo      String    @unique
  descripcion String    @db.VarChar(500)
  precioCosto Decimal   @db.Decimal(12, 2)
  precioVenta Decimal   @db.Decimal(12, 2)
  imagen      String?   @db.VarChar(500)
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoriaId])
}
